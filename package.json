{
  "name": "@mochi-forms/workspace",
  "private": true,
  "author": "John Rom <web@johnrom.com>",
  "version": "0.0.0",
  "engines": {
    "node": "16.14.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "resolutions": {
    "**/typescript": "^4.6.3",
    "**/eslint-plugin-react-hooks": "^4.3.0",
    "**/@typescript-eslint/parser": "^5.21.0",
    "**/@typescript-eslint/eslint-plugin": "^5.21.0",
    "**/@types/react": "^17.0.21"
  },
  "scripts": {
    "build": "lerna run build",
    "lint:scripts": "eslint .",
    "postinstall": "npm run setup:expo",
    "setup": "npm run setup:npm && npm run setup:yarn && npm run setup:install",
    "setup:crossenv": "npm install -g cross-env",
    "setup:expo": "cd ./packages/mochi-forms-dev-app-native && expo-yarn-workspaces postinstall",
    "setup:install": "yarn",
    "setup:npm": "npm run setup:crossenv && cross-env-shell \"nvm install $npm_package_engines_node && nvm use $npm_package_engines_node\"",
    "setup:yarn": "npm i -g yarn",
    "start:web": "yarn --cwd ./packages/mochi-forms-dev-app-web run dev",
    "start:native": "yarn --cwd ./packages/mochi-forms-dev-app-native run start",
    "start:website": "yarn --cwd ./packages/mochi-forms-docs-website run start",
    "test": "lerna run test -- --silent",
    "test:watch": "lerna run test --stream --no-sort -- --watch",
    "test:watchAll": "lerna run test --stream --no-sort -- --watchAll",
    "test:vscode": "lerna run test --stream --no-sort --"
  },
  "dependencies": {
    "@babel/core": "^7.0.0",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^7.16.7",
    "@changesets/cli": "^2.21.1",
    "@tsconfig/node16-strictest-esm": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^5.21.0",
    "@typescript-eslint/parser": "^5.21.0",
    "eslint": "7.32.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-react": "^7.29.4",
    "husky": "^4.3.0",
    "lerna": "^4.0.0",
    "lint-staged": "^10.4.0",
    "prettier": "^2.6.1",
    "typescript": "^4.6.3"
  }
}
