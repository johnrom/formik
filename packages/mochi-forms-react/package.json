{
  "name": "@mochi-forms/react",
  "description": "A sweet React form library",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "author": "John Rom <web@johnrom.com>",
  "repository": "johnrom/mochi-forms",
  "homepage": "https://mochidocs.com",
  "keywords": [
    "formik",
    "forms",
    "react",
    "react-dom",
    "hooks",
    "react hooks",
    "validation",
    "render props",
    "validation",
    "higher order component",
    "hoc"
  ],
  "main": "dist/index.js",
  "react-native": "dist/index.native.js",
  "umd:main": "dist/formik.umd.production.js",
  "module": "dist/formik.esm.js",
  "types": "index.d.ts",
  "typesVersions": {
    ">=4.1": {
      "*": [
        "dist/*"
      ]
    },
    "<4.1": {
      "*": [
        "dist-untyped/*"
      ]
    }
  },
  "files": [
    "dist",
    "dist-untyped"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "react-native": "^0.64.2"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "scripts": {
    "test": "jest --silent",
    "test:watch": "yarn test -- --watchAll",
    "start": "tsdx watch --verbose --noClean",
    "build": "yarn run build-native && yarn run move-native && yarn run build-alternate && yarn run move-alternate && yarn run build-web && yarn run build-untyped",
    "build-native": "yarn run tsdx build --entry src/index.native.tsx --name formik-v3.native",
    "move-native": "mv dist/index.js dist/index.native.js",
    "build-alternate": "yarn run tsdx build --noClean --entry src/index.alternate.tsx --name formik-v3.alternate",
    "move-alternate": "mv dist/index.js dist/index.alternate.js",
    "build-web": "yarn run tsdx build --noClean",
    "build-untyped": "rimraf dist-untyped && tsc --emitDeclarationOnly --noEmit false --outDir dist-untyped",
    "lint": "tsdx lint"
  },
  "dependencies": {
    "deepmerge": "^2.1.1",
    "hoist-non-react-statics": "^3.3.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "react-fast-compare": "^2.0.1",
    "tiny-warning": "^1.0.2",
    "use-optimized-selector": "^1.0.0-beta3",
    "use-subscription": "^1.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@johnrom/tsdx": "0.14.2-noclean3",
    "@testing-library/react": "^11.1.0",
    "@tsconfig/node16-strictest": "^1.0.0",
    "@types/hoist-non-react-statics": "^3.3.1",
    "@types/jest": "^27.0.2",
    "@types/lodash": "^4.14.119",
    "@types/react": "^17.0.21",
    "@types/react-dom": "^17.0.11",
    "@types/use-subscription": "^1.0.0",
    "@types/warning": "^3.0.0",
    "@types/yup": "^0.24.9",
    "babel-jest": "^27.5.1",
    "jest": "^27.5.1",
    "react": "17.0.1",
    "react-dom": "^17.0.2",
    "react-native": "0.64.3",
    "typescript": "^4.6.3",
    "yup": "^0.28.1"
  }
}
