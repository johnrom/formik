{
  "extends": "@tsconfig/node16-strictest/tsconfig.json",
  "include": ["src"],
  "compilerOptions": {
    "target": "es5",
    "module": "esnext",
    "lib": ["dom", "esnext"],
    "jsx": "react",
    "moduleResolution": "node",

    "emitDeclarationOnly": true,
    "declaration": true,
    "sourceMap": true,
  }
}
