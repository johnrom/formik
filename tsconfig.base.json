{
  "extends": "@tsconfig/node16-strictest-esm/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "rootDir": "./packages",
    "paths": {
      "@mochi-forms/examples": ["./packages/mochi-forms-examples/src"],
      "@mochi-forms/react": ["./packages/mochi-forms-react/src"],
      "@mochi-forms/react-native": ["./packages/mochi-forms-react-native/src"]
    },
    "types": ["node"]
  }
}
