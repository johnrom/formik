{
  "extends": "@tsconfig/node16-strictest-esm/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "rootDir": "./packages",
    "paths": {
      "@mochi-forms/examples": ["./packages/mochi-forms-examples/src"],
      "@mochi-forms/react": ["./packages/mochi-forms-react/src"],
      "@mochi-forms/react-native": ["./packages/mochi-forms-react-native/src"]
    },
    "types": ["node"],

    // These should be removed eventually, but we'll override them while fixing Formik code.
    "noImplicitOverride": false
  }
}
