{
  "extends": "@tsconfig/node16-strictest-esm/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "types": ["node"],

    // These should be removed eventually, but we'll override them while fixing Formik code.
    "noImplicitOverride": false
  }
}
